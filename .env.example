PORT=3000
HOST=0.0.0.0

# Gmail account used to send record notifications and student password-reset codes.
# Use a Google app password, not the normal Gmail password.
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
# Defaults to SMTP_USER if left unset.
ADMIN_NOTIFICATION_EMAIL=admin-email@example.com